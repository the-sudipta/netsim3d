{
  "name": "NetSim3D",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "NetSim3D",
      "onAutoForward": "notify"
    }
  },

  "containerEnv": {
    "NETSIM_HOST": "0.0.0.0",
    "NETSIM_OPEN": "0"
  },

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
